discovery.docker "vertical" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=vertical"]
  }
}
discovery.relabel "vertical" {
  targets = discovery.docker.vertical.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
}
loki.source.docker "vertical" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.vertical.output
  labels = {job = "vertical"}
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
